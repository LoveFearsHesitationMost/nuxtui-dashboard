{
  "name": "otomo-frontend",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-ruby": "^5.2.2",
    "vite-svg-loader": "^5.1.2"
  },
  "dependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@inertiajs/vite": "^3.7.0",
    "@inertiajs/vue3": "^3.7.0",
    "@nuxt/ui": "^4.11.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "tailwindcss": "^4.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.1",
    "zod": "^4.3.5"
  },
  "scripts": {
    "check": "vue-tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint \"app/frontend/**/*.{ts,tsx,vue}\"",
    "lint:fix": "eslint \"app/frontend/**/*.{ts,tsx,vue}\" --fix",
    "format": "prettier --write \"app/frontend/**/*.{ts,tsx,vue,js,json,css}\"",
    "format:check": "prettier --check \"app/frontend/**/*.{ts,tsx,vue,js,json,css}\""
  }
}

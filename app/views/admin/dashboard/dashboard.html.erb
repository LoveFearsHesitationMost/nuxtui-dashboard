<div class="admin-dashboard">
  <div class="admin-header">
    <h1 class="admin-title">管理后台</h1>
    <p class="admin-subtitle">欢迎来到管理控制台</p>
    <div class="admin-current-user">
      当前登录：<%= current_admin.email %>
    </div>
  </div>

  <!-- 统计卡片 -->
  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <div class="admin-stat-content">
        <div class="admin-stat-icon admin-icon-blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE -->
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 13a2 2 0 1 0 4 0a2 2 0 0 0-4 0m-2 8v-1a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1M15 5a2 2 0 1 0 4 0a2 2 0 0 0-4 0m2 5h2a2 2 0 0 1 2 2v1M5 5a2 2 0 1 0 4 0a2 2 0 0 0-4 0m-2 8v-1a2 2 0 0 1 2-2h2"/>
          </svg>
        </div>
        <div class="admin-stat-info">
          <p class="admin-stat-label">总用户数</p>
          <p class="admin-stat-value"><%= @users_count %></p>
        </div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-content">
        <div class="admin-stat-icon admin-icon-green">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE -->
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0-8 0M6 21v-2a4 4 0 0 1 4-4h2.5m4.501 4a2 2 0 1 0 4 0a2 2 0 1 0-4 0m2-3.5V17m0 4v1.5m3.031-5.25l-1.299.75m-3.463 2l-1.3.75m0-3.5l1.3.75m3.463 2l1.3.75"/>
          </svg>
        </div>
        <div class="admin-stat-info">
          <p class="admin-stat-label">管理员用户</p>
          <p class="admin-stat-value"><%= @admin_users_count %></p>
        </div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-content">
        <div class="admin-stat-icon admin-icon-purple">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE -->
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0-8 0M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
          </svg>
        </div>
        <div class="admin-stat-info">
          <p class="admin-stat-label">普通用户</p>
          <p class="admin-stat-value"><%= @regular_users_count %></p>
        </div>
      </div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-content">
        <div class="admin-stat-icon admin-icon-orange">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <!-- Icon from Tabler Icons by Paweł Kuna - https://github.com/tabler/tabler-icons/blob/master/LICENSE -->
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h4l3 8l4-16l3 8h4"/>
          </svg>
        </div>
        <div class="admin-stat-info">
          <p class="admin-stat-label">活跃会话</p>
          <p class="admin-stat-value"><%= @sessions_count %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- 快捷操作 -->
  <div class="admin-actions-section">
    <div class="admin-actions-header">
      <h2 class="admin-actions-title">快捷操作</h2>
    </div>
    <div class="admin-actions-content">
      <div class="admin-actions-grid">
        <%= link_to admin_users_path, class: "admin-action-btn admin-action-btn-primary" do %>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
          </svg>
          管理用户
        <% end %>

        <%= link_to admin_sign_out_path, method: :delete, data: { confirm: '确定要退出登录吗？' }, class: "admin-action-btn admin-action-btn-danger" do %>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/>
          </svg>
          退出登录
        <% end %>
      </div>
    </div>
  </div>
</div>